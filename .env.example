# ============================================
# VillaOps AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- App ---
APP_NAME=VillaOps AI
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://villa:villa_secret@localhost:5432/villa_ops

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# --- LLM (LiteLLM) ---
DEFAULT_LLM_MODEL=openrouter/openai/gpt-6-luna
TITLE_LLM_MODEL=gemini/gemini-3.1-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional fallback via OpenRouter free models
OPENROUTER_API_KEY=
LITELLM_CACHE_ENABLED=true

# --- Exa (Web Search) ---
EXA_API_KEY=

# --- MCP Server ---
MCP_SERVER_URL=http://localhost:8001/mcp

# --- Market data MCP servers (mcp-servers/) ---
# docker-compose sets the *_MCP_URL values for the backend; leave a URL empty to disable that source.
BOOKING_MCP_URL=
AIRBNB_MCP_URL=
TRIPADVISOR_MCP_URL=
# Booking.com via RapidAPI (booking-com15, free Basic plan = 600 requests/month)
RAPIDAPI_KEY=
# Tripadvisor Terra Partner API key (billed per location returned; first 1,000 free)
TRIPADVISOR_API_KEY=
# Airbnb search pages are disallowed by robots.txt; set true to opt in (as with upstream's --ignore-robots-txt)
AIRBNB_IGNORE_ROBOTS_TXT=false

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Knowledge base (Pinecone) and tracing (LangSmith)
PINECONE_API_KEY=
PINECONE_INDEX=villaops-kb
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=villaops-ai

# Voice mode (Villa, voice-agent/): LiveKit Cloud project + ElevenLabs. Empty LiveKit keys = voice off.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret: voice agent -> backend transcript endpoints (any long random string)
VOICE_AGENT_SECRET=
ELEVEN_API_KEY=
# Optional: ElevenLabs voice and model (defaults: "hanna", eleven_flash_v2_5)
ELEVEN_VOICE_ID=
ELEVEN_MODEL=
