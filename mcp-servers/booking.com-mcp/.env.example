# RapidAPI key subscribed to the Booking.com API (booking-com15) — free Basic plan is 600 requests/month
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com

# Optional: cache API responses in Redis (strongly recommended on the free plan)
REDIS_URL=redis://localhost:6379/0
BOOKING_CACHE_TTL=21600

PORT=8002
